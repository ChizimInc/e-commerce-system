# Copiaza in .env si ajusteaza valorile (comanda: `cp .env.example .env`).
# Valorile implicite se potrivesc cu docker-compose.yml.

# Aplicatie
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Baza de date (PostgreSQL din docker-compose.yml)
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public"

# Secret pentru semnarea JWT (minim 32 de caractere). Genereaza unul propriu:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret-of-32-chars-or-more
# Valabilitatea tokenului de acces (secunde) si costul bcrypt (4-15)
JWT_EXPIRES_IN_SECONDS=3600
BCRYPT_ROUNDS=10
# Limita de cereri per IP pe /auth/register si /auth/login (anti brute-force); fereastra in secunde
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# Pret: TVA (procente) adaugat la subtotalul redus si praguri de reducere dupa subtotal, `cenți:procent` separate prin virgula
# (ex. de la 500.00 reducere 5%, de la 1000.00 reducere 10%). DISCOUNT_TIERS= (gol) dezactiveaza reducerile.
VAT_PERCENT=19
DISCOUNT_TIERS=50000:5,100000:10

# Validarea comenzii: tari de livrare (coduri ISO), total maxim (cenți), reguli anti-frauda
# (max. comenzi per client intr-o fereastra de timp; un total peste pragul suspect cere verificare manuala).
SHIPPING_COUNTRIES=RO,MD
MAX_ORDER_AMOUNT_CENTS=100000000
FRAUD_MAX_ORDERS_PER_WINDOW=5
FRAUD_WINDOW_SECONDS=600
FRAUD_SUSPICIOUS_AMOUNT_CENTS=50000000

# Plati (furnizori MOCK, fara retea): secretul cu care furnizorii isi semneaza webhook-urile (HMAC), minim 16 caractere.
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PAYMENT_WEBHOOK_SECRET=replace-me-with-a-random-webhook-secret

# Contul de administrator creat de `npm run db:seed` (ADMIN nu se poate crea prin API-ul public).
# Parola e obligatorie pentru seed (minim 8 caractere); alege una proprie, nu o lasa goala.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
