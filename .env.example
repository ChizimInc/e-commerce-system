# Copiaza in .env si ajusteaza valorile (comanda: `cp .env.example .env`).
# Valorile implicite se potrivesc cu docker-compose.yml.

# Aplicatie
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Baza de date (PostgreSQL din docker-compose.yml)
DATABASE_URL="postgresql://ecommerce:ecommerce@localhost:5432/ecommerce?schema=public"

# Secret pentru semnarea JWT (minim 32 de caractere). Genereaza unul propriu:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-secret-of-32-chars-or-more
