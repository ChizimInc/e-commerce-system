// Schema Prisma. Banii se stocheaza mereu in cenți (Int) + moneda, niciodata float (vezi docs/PLAN.md §6).
// Se extinde pe masura ce iteratiile adauga module (catalog, cart, ordering etc.).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now()) @map("created_at")
  cart         Cart?
  orders       Order[]

  @@map("users")
}

enum Currency {
  RON
  EUR
  USD
}

// Categorii ierarhice (self-reference prin parent_id). Stergerea unei categorii cu copii/produse e blocata.
model Category {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  parentId  String?    @map("parent_id") @db.Uuid
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now()) @map("created_at")

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  description String       @default("")
  priceAmount Int          @map("price_amount") // in cenți
  currency    Currency
  stock       Int
  categoryId  String?      @map("category_id") @db.Uuid
  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bundleItems BundleItem[]
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([name])
  @@map("products")
}

// Pachet de produse: pretul se calculeaza din componente (nu se stocheaza).
model Bundle {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  description     String       @default("")
  discountPercent Int          @default(0) @map("discount_percent")
  items           BundleItem[]
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  @@map("bundles")
}

model BundleItem {
  bundleId  String  @map("bundle_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([bundleId, productId])
  @@index([productId])
  @@map("bundle_items")
}

// Un singur cos per utilizator. Articolele refera un produs SAU un pachet (de aceea item_id nu are FK).
model Cart {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @map("user_id") @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  cartId   String @map("cart_id") @db.Uuid
  itemId   String @map("item_id") @db.Uuid
  quantity Int
  position Int // ordinea de adaugare in cos
  cart     Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@id([cartId, itemId])
  @@map("cart_items")
}

enum OrderStatus {
  NEW
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum DeliveryMethod {
  STANDARD
  EXPRESS
  STORE_PICKUP
}

enum PaymentMethod {
  CARD
  PAYPAL
  CASH_ON_DELIVERY
}

// Comanda. Totalul e in cenți (Int) + moneda; adresa de livrare e un value object, stocat in coloane (prefix shipping_).
// paid_at ramane setat si dupa anulare: arata ca o comanda anulata a fost platita (deci e rambursabila).
model Order {
  id                 String         @id @default(uuid()) @db.Uuid
  customerId         String         @map("customer_id") @db.Uuid
  customer           User           @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status             OrderStatus    @default(NEW)
  // Rezultatul calculului de pret (in cenți): total = subtotal - discount + vat. Pastrate separat, ca sa se vada ce s-a aplicat.
  subtotalAmount     Int            @map("subtotal_amount")
  discountAmount     Int            @map("discount_amount")
  vatAmount          Int            @map("vat_amount")
  totalAmount        Int            @map("total_amount")
  currency           Currency
  deliveryMethod     DeliveryMethod @map("delivery_method")
  paymentMethod      PaymentMethod  @map("payment_method")
  shippingRecipient  String         @map("shipping_recipient")
  shippingStreet     String         @map("shipping_street")
  shippingCity       String         @map("shipping_city")
  shippingPostalCode String         @map("shipping_postal_code")
  shippingCountry    String         @map("shipping_country")
  paidAt             DateTime?      @map("paid_at")
  items              OrderItem[]
  stockRestoration   OrderStockRestoration?
  payment            Payment?
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  @@index([customerId, createdAt])
  @@map("orders")
}

// Linie de comanda: instantaneu al produsului la momentul comenzii (nume + pret copiate). item_id nu are FK:
// produsul/pachetul poate fi sters ulterior, iar comanda trebuie sa ramana intreaga.
model OrderItem {
  orderId         String @map("order_id") @db.Uuid
  itemId          String @map("item_id") @db.Uuid
  name            String
  unitPriceAmount Int    @map("unit_price_amount") // in cenți
  quantity        Int
  position        Int // ordinea din comanda
  order           Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@id([orderId, itemId])
  @@map("order_items")
}

// Marcheaza comenzile al caror stoc a fost deja repus dupa anulare: face repunerea idempotenta
// (inserarea si cresterea stocului se fac in aceeasi tranzactie, iar cheia primara opreste a doua repunere).
model OrderStockRestoration {
  orderId    String   @id @map("order_id") @db.Uuid
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  restoredAt DateTime @default(now()) @map("restored_at")

  @@map("order_stock_restorations")
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  COD
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  REFUNDING
  REFUNDED
  DECLINED
  FAILED
}

// Plata unei comenzi: o singura plata per comanda (order_id UNIQUE) si cheie de idempotenta unica ("pay:<orderId>"),
// deci doua cereri simultane nu pot plati aceeasi comanda de doua ori. Suma e in cenți (Int) + moneda, ca in orders.
// external_id = id-ul tranzactiei la furnizor (unic per furnizor); refund_external_id = id-ul rambursarii.
// Plata nu se sterge odata cu comanda (Restrict): e o inregistrare financiara.
model Payment {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @unique @map("order_id") @db.Uuid
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider         PaymentProvider
  status           PaymentStatus   @default(PENDING)
  amount           Int // in cenți
  currency         Currency
  externalId       String?         @map("external_id")
  refundExternalId String?         @map("refund_external_id")
  failureReason    String?         @map("failure_reason")
  idempotencyKey   String          @unique @map("idempotency_key")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@unique([provider, externalId])
  @@map("payments")
}
